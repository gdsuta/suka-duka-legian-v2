# Salin ke .env.local lalu isi nilainya.

# Connection string Neon (pooled). Otomatis di-set bila Neon ditambahkan
# lewat Vercel → Storage. Di Neon Console: Connect → pilih "Pooled connection".
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Kunci acak ≥ 32 karakter untuk menandatangani cookie sesi admin.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=ganti-dengan-string-acak-minimal-32-karakter
